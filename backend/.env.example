# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/axaro

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── PayPal ──────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ── Stripe ──────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from https://dashboard.stripe.com/webhooks (after creating a webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary (image uploads) ──────────────────────────────────────────────────
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Redis (BullMQ queues) ───────────────────────────────────────────────────────
# Optional – queues are gracefully disabled when Redis is unavailable
REDIS_URL=redis://127.0.0.1:6379

# ── Email (SMTP via Nodemailer) ─────────────────────────────────────────────────
# Example settings for Gmail (use App Password if 2FA is enabled):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Axaro Store <no-reply@axaro.store>
